{
  "name": "jevgrep",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/core",
      "packages/typescript-config"
    ],
    "catalog": {
      "typescript": "5.9.3",
      "@types/bun": "1.3.14"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun apps/cli/src/index.ts",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "turbo": "2.10.3",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
